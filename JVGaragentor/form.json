    },
    {
      "type": "CheckBox",
      "name": "EnableControl",
      "caption": "Toransteuerung freigeben (erst nach CS320- und Relais-Test)"
    },
    {
      "type": "SelectVariable",
      "name": "RelayOpenVariable",
      "caption": "Shelly AUF – O1, Status, ID 44228"
    },
    {
      "type": "SelectVariable",
      "name": "RelayCloseVariable",
      "caption": "Shelly ZU – O2, Status 1, ID 56652"
    },
    {
      "type": "SelectVariable",
      "name": "RelayStopVariable",
      "caption": "Shelly STOP – O3, Status 2, ID 55944"
    },
    {
      "type": "SelectVariable",
      "name": "OnlineVariable",
      "caption": "Shelly Erreichbar – ID 17585"
    },
